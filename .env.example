# =================================================================
# CONFIGURACIÓN DE LA APLICACIÓN MULTIMEDIA (MP3 & SPOTIFY)
# =================================================================

# Credenciales de Spotify API (Obtén las tuyas gratis en https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# -----------------------------------------------------------------
# SEGURIDAD - Protección con contraseña (HTTP Basic)
# -----------------------------------------------------------------
# Dejalo VACÍO si solo la usás en tu PC (no te va a pedir nada).
#
# IMPORTANTE: si la publicás en internet (Render, etc.) ponele una
# contraseña. Sin esto, cualquiera con la URL puede ver, descargar
# y BORRAR tus archivos. El navegador te va a pedir usuario y clave.
APP_USERNAME=admin
APP_PASSWORD=

# Configuración del Servidor
PORT=8000
HOST=0.0.0.0

# Carpeta predeterminada para descargas locales
DOWNLOAD_DIR=descargas

# Calidad predeterminada de audio (kbps: 320, 256, 192, 128)
DEFAULT_AUDIO_BITRATE=192

# Calidad predeterminada de video (1080p, 720p, 480p, best)
DEFAULT_VIDEO_QUALITY=best
