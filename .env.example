# =================================================================
# CONFIGURACIÓN DE LA APLICACIÓN MULTIMEDIA (MP3 & SPOTIFY)
# =================================================================

# Credenciales de Spotify API (Obtén las tuyas gratis en https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# -----------------------------------------------------------------
# SEGURIDAD - Protección con contraseña (HTTP Basic)
# -----------------------------------------------------------------
# Dejalo VACÍO si solo la usás en tu PC (no te va a pedir nada).
#
# IMPORTANTE: si la publicás en internet (Render, etc.) ponele una
# contraseña. Sin esto, cualquiera con la URL puede ver, descargar
# y BORRAR tus archivos. El navegador te va a pedir usuario y clave.
APP_USERNAME=admin
APP_PASSWORD=

# Configuración del Servidor
PORT=8000
HOST=0.0.0.0

# Carpeta predeterminada para descargas locales
DOWNLOAD_DIR=descargas

# Calidad predeterminada de audio (kbps: 320, 256, 192, 128)
DEFAULT_AUDIO_BITRATE=192

# Calidad predeterminada de video (1080p, 720p, 480p, best)
DEFAULT_VIDEO_QUALITY=best

# -----------------------------------------------------------------
# YOUTUBE DESDE UN HOSTING (Render, etc.) - OPCIONAL
# -----------------------------------------------------------------
# YouTube bloquea las IPs de datacenter. Por eso la app en Render falla con
# "Failed to extract any player response" o "Sign in to confirm you're not
# a bot" aunque en tu PC funcione perfecto. Hay dos remedios (se pueden
# combinar). En tu PC dejá todo vacío.
#
# 1) Cookies de una sesión de YouTube iniciada en el navegador.
#    Exportalas en formato Netscape con una extensión como
#    "Get cookies.txt LOCALLY" estando en youtube.com con sesión abierta.
#    yt-dlp recomienda usar una cuenta secundaria, no la principal.
#    - En Render: Environment > Secret Files > subir el archivo como
#      "cookies.txt" y acá poner la ruta donde Render lo monta:
#      YTDLP_COOKIES_FILE=/etc/secrets/cookies.txt
#    - Si el hosting no tiene archivos secretos: pegá el archivo en base64
#      en YTDLP_COOKIES_B64 (en PowerShell:
#      [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt")) ).
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=
#
# 2) Proxy residencial por donde salen las peticiones a YouTube.
#    Formato: http://usuario:clave@host:puerto   (también socks5://...)
YTDLP_PROXY=
